{
  "SAConnection": {
    "display_name": "API 连接",
    "description": "一次配置，多节点共用。中转站填写其地址并选择接口格式。",
    "inputs": {
      "provider": {
        "name": "平台",
        "tooltip": ""
      },
      "base_url": {
        "name": "API 地址",
        "tooltip": "填含版本号的基础地址；预设平台可留空。"
      },
      "api_key": {
        "name": "API 密钥",
        "tooltip": "可填密钥、env:变量名、key:本地名称。直接填写会保存在工作流中。"
      },
      "protocol": {
        "name": "接口格式",
        "tooltip": "auto 跟随平台；中转站按其文档选择。"
      }
    },
    "outputs": {
      "0": {
        "name": "连接"
      }
    }
  },
